---
import type { Destination } from "../data/links";

/**
 * The four entry points as one row along the bottom edge (two by two on a phone).
 * Hover or focus reshapes the background cloud into that destination's form.
 * 4 つの入口を下端に 1 列で（スマホでは 2×2）。ホバー/フォーカスで背景の雲がその形に変わる。
 */
interface Props {
  items: readonly Destination[];
  /** Offset for the load-in stagger. / 入場アニメーションの開始順 */
  startIndex?: number;
}

const { items, startIndex = 0 } = Astro.props;
---

<ul class="grid grid-cols-2 gap-x-6 gap-y-7 lg:grid-cols-4 lg:gap-x-10">
  {
    items.map((item, i) => (
      <li class="rise" style={`--i: ${startIndex + i}`}>
        <a href={item.href} data-destination={item.id} class="group flex flex-col gap-2 py-1">
          <span class="flex items-baseline justify-between gap-3">
            <span class="font-display text-item leading-none font-light tracking-[-0.025em] transition-transform duration-500 ease-out-expo group-hover:translate-x-1.5 group-focus-visible:translate-x-1.5">
              {item.title}
            </span>
            {/* Drawn arrow: the ↗ glyph fell back to a hairline system font. / ↗ の文字はシステムフォントの細線に落ちるため SVG で描く */}
            <svg
              aria-hidden="true"
              viewBox="0 0 12 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-[0.45em] shrink-0 text-item text-muted transition duration-500 ease-out-expo group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent group-focus-visible:text-accent"
            >
              <path d="M1 11L11 1M3.5 1H11v7.5" />
            </svg>
          </span>
          {/* Brand gets its own line except in the roomy two-column row. / 余裕のある 2 列表示以外ではブランド名を独立した行に */}
          <span class="text-small leading-relaxed text-muted [text-wrap:pretty] [word-break:auto-phrase]">
            <span class="whitespace-nowrap text-ink">{item.brand}</span>
            <span class="max-sm:block sm:ml-2 lg:ml-0 lg:block">{item.description}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<script>
  // Hover and focus set the background's shape; leaving the list returns it to "&".
  // ホバーとフォーカスで背景の形を決め、リストから離れると「&」に戻す。
  const emit = (id: string | null) => window.dispatchEvent(new CustomEvent("destination:hover", { detail: id }));

  document.querySelectorAll<HTMLAnchorElement>("a[data-destination]").forEach((link) => {
    const id = link.dataset.destination ?? null;
    // Mouse only: on touch, pointerleave may never fire and the shape would stick.
    // マウスのみ：タッチでは pointerleave が来ないことがあり、形が戻らなくなるため。
    link.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && emit(id));
    link.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && emit(null));
    link.addEventListener("focus", () => emit(id));
    link.addEventListener("blur", () => emit(null));
  });
</script>
