---
import Base from "../layouts/Base.astro";
import FlowArt from "../components/FlowArt.astro";
import DestinationList from "../components/DestinationList.astro";
import { destinations } from "../data/links";

const FOUNDED = 2013;
---

<Base
  title="andCreate"
  description="アンドクリエイトの入口。Web制作、VRChatワールド・3Dライブ制作、#StudioLouie のアセット販売とドキュメントへ。"
>
  <div class="grid min-h-[100dvh] grid-cols-1 lg:grid-cols-12">
    <FlowArt class="h-[42svh] min-h-64 lg:sticky lg:top-0 lg:col-span-6 lg:h-svh xl:col-span-7" />

    <div class="flex flex-col justify-between gap-16 px-4 pt-10 pb-8 sm:px-8 lg:col-span-6 lg:min-h-[100dvh] lg:px-12 lg:pt-24 lg:pb-10 xl:col-span-5 xl:px-16">
      <main class="flex flex-col gap-12 lg:gap-16">
        <header class="flex flex-col gap-4">
          <h1 class="reveal font-display text-6xl leading-[0.95] font-semibold tracking-tighter md:text-7xl" style="--i: 0">
            andCreate
          </h1>
          <p class="reveal text-base leading-relaxed text-muted [word-break:auto-phrase]" style="--i: 1">
            関わる全ての人にプラスとなるものを
          </p>
        </header>

        <nav aria-label="サイト一覧">
          <DestinationList items={destinations} startIndex={2} />
        </nav>
      </main>

      <footer class="reveal text-xs text-muted" style={`--i: ${destinations.length + 2}`}>
        <small class="text-xs">&copy; {FOUNDED} andCreate</small>
      </footer>
    </div>
  </div>
</Base>
